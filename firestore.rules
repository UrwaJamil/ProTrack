rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Any signed-in user may read a profile (member lists, assignee
    // pickers, @mentions), but only their own doc is writable. List
    // queries (the "Assign Team Member" email search, avatar lookups by
    // id) must set limit <= 30, which makes bulk-downloading every profile
    // harder. `emailLower`, when present, must match `email`.
    match /users/{uid} {
      function emailLowerOk() {
        return !('emailLower' in request.resource.data)
          || request.resource.data.emailLower
            == request.resource.data.email.trim().lower();
      }

      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 30;
      allow create, update: if signedIn() && request.auth.uid == uid
        && emailLowerOk();
      allow delete: if false;
    }

    // Pre-auth "is this email taken?" lookup for the register screen
    // (CLAUDE.md §9). Anyone may fetch a single doc by its exact id, but
    // never list the collection. A signed-in user may only write the entry
    // for their own Auth email, holding only their own uid. Update is
    // allowed so an entry left behind by a deleted account can be reclaimed.
    match /emailIndex/{email} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.token.email != null
        && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Projects (CLAUDE.md decisions 1 and 3). A user's role in a project
    // is `members[uid]` ("leader" = Admin, "member" = Member). Members of
    // a project may read it; only its Admins may change or delete it.
    match /projects/{projectId} {
      function isProjectMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      function isProjectLeader() {
        return signedIn()
          && resource.data.members.get(request.auth.uid, '') == 'leader';
      }

      // Shape shared by create and update.
      function validProject(d) {
        return d.keys().hasOnly(['name', 'description', 'startDate',
            'deadline', 'status', 'createdBy', 'members', 'memberIds',
            'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.description is string && d.description.size() <= 500
          && d.startDate is timestamp && d.deadline is timestamp
          && d.deadline > d.startDate
          && d.status in ['active', 'archived']
          && d.members is map && d.memberIds is list
          // memberIds is exactly the keys of members, no duplicates.
          && d.memberIds.size() == d.members.size()
          && d.memberIds.toSet() == d.members.keys().toSet()
          && d.members.values().toSet().hasOnly(['leader', 'member']);
      }

      allow read: if isProjectMember();

      // Only users whose default role is Admin may create projects, and
      // only with themselves as the sole member and Admin.
      allow create: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.defaultRole == 'leader'
        && validProject(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members[request.auth.uid] == 'leader'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Admins edit details, archive/restore and add/remove members. The
      // creator always stays an Admin and can't be removed.
      allow update: if isProjectLeader()
        && validProject(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.members.get(resource.data.createdBy, '')
          == 'leader'
        && request.resource.data.updatedAt == request.time;

      allow delete: if isProjectLeader();

      // Tasks (CLAUDE.md decision 3, Phase 3). Project members read every
      // task; project Admins create, edit, reassign and delete; an
      // assignee may change only status / helpNote / subtasks /
      // attachments on their own task. Nothing is writable while the
      // project is archived.
      match /tasks/{taskId} {
        function project() {
          return get(/databases/$(database)/documents/projects/$(projectId))
            .data;
        }

        function isMember() {
          return signedIn() && request.auth.uid in project().memberIds;
        }

        function isLeader() {
          return signedIn()
            && project().members.get(request.auth.uid, '') == 'leader';
        }

        function projectActive() {
          return project().status == 'active';
        }

        function validStatus(s) {
          return s in ['todo', 'in_progress', 'on_hold', 'blocked',
            'completed'];
        }

        // Shape shared by create and update. Subtask entries can't be
        // checked one by one (rules have no loops), only the list size.
        // An empty assignedTo is allowed so removing a task's only
        // assignee from the project still works; the app's form requires
        // at least one.
        function validTask(d) {
          return d.keys().hasOnly(['title', 'description', 'assignedTo',
              'priority', 'status', 'deadline', 'helpNote', 'subtasks',
              'attachments', 'createdBy', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['title', 'description', 'assignedTo',
              'priority', 'status', 'deadline', 'subtasks', 'createdBy',
              'createdAt', 'updatedAt'])
            && d.title is string && d.title.size() > 0
            && d.title.size() <= 100
            && d.description is string && d.description.size() <= 2000
            && d.assignedTo is list
            && d.assignedTo.toSet().size() == d.assignedTo.size()
            && d.assignedTo.toSet().hasOnly(project().memberIds)
            && d.priority in ['high', 'medium', 'low']
            && validStatus(d.status)
            && d.deadline is timestamp
            && d.subtasks is list && d.subtasks.size() <= 50;
        }

        function leaderUpdate() {
          return isLeader() && projectActive()
            && validTask(request.resource.data)
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time;
        }

        // FR-3.5 / FR-3.6: the assignee ticks subtasks (same count) and
        // changes status, nothing else.
        function assigneeUpdate() {
          return isMember() && projectActive()
            && request.auth.uid in resource.data.assignedTo
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'helpNote', 'subtasks', 'attachments',
                'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && validStatus(request.resource.data.status)
            && request.resource.data.subtasks is list
            && request.resource.data.subtasks.size()
              == resource.data.subtasks.size();
        }

        allow read: if isMember();

        allow create: if isLeader() && projectActive()
          && validTask(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if leaderUpdate() || assigneeUpdate();

        allow delete: if isLeader() && projectActive();

        // Comments (Phase 4, CLAUDE.md decision 5). Project members read
        // and post while the project is active; the author may change only
        // the text; the author or a project Admin deletes.
        match /comments/{commentId} {
          function validText(t) {
            return t is string && t.trim().size() > 0 && t.size() <= 2000;
          }

          allow read: if isMember();

          allow create: if isMember() && projectActive()
            && exists(/databases/$(database)/documents/projects/$(projectId)/tasks/$(taskId))
            && request.resource.data.keys()
              .hasOnly(['authorId', 'text', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && validText(request.resource.data.text)
            && request.resource.data.createdAt == request.time;

          allow update: if isMember() && projectActive()
            && resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'editedAt'])
            && validText(request.resource.data.text)
            && request.resource.data.editedAt == request.time;

          allow delete: if projectActive()
            && (isLeader()
              || (isMember() && resource.data.authorId == request.auth.uid));
        }

        // History (Phase 4): create-only, never edited or deleted. An
        // entry names its writer (`who == uid`), so nobody can log an
        // action as someone else.
        // * A project Admin or the task's assignee writes any action but
        //   `help_accepted`. Phase 4 writes `help_requested` (in the same
        //   batch as the Blocked status + help note, with the entry id
        //   stored as `helpNote.requestId`); the other actions are reserved
        //   for history from the existing flows.
        // * `help_accepted` is written only by the helper named in the
        //   task's `helpNote.taggedUserId` (a project member, not an
        //   assignee), at the fixed id `accept_<helpNote.requestId>`. A
        //   second accept of the same request would be an update, which
        //   is never allowed, so each request is accepted at most once.
        match /history/{entryId} {
          function taskDoc() {
            return get(/databases/$(database)/documents/projects/$(projectId)/tasks/$(taskId)).data;
          }

          function optionalString(d, key) {
            return !(key in d) || d[key] is string;
          }

          allow read: if isMember();

          function validEntry(d) {
            return d.keys().hasOnly(['who', 'action', 'from', 'to', 'at'])
              && d.who == request.auth.uid
              && optionalString(d, 'from')
              && optionalString(d, 'to')
              && d.at == request.time;
          }

          function assigneeOrLeaderEntry(d) {
            return (isLeader() || request.auth.uid in taskDoc().assignedTo)
              && d.action in ['created', 'status_changed', 'edited',
                'reassigned', 'subtask_completed', 'help_requested'];
          }

          function helperAccepts(d) {
            let note = taskDoc().get('helpNote', {});
            return d.action == 'help_accepted'
              && note.get('taggedUserId', '') == request.auth.uid
              && note.get('requestId', '') is string
              && note.get('requestId', '') != ''
              && entryId == 'accept_' + note.requestId
              && !(request.auth.uid in taskDoc().assignedTo);
          }

          allow create: if isMember() && projectActive()
            && validEntry(request.resource.data)
            && (assigneeOrLeaderEntry(request.resource.data)
              || helperAccepts(request.resource.data));

          allow update, delete: if false;
        }
      }
    }

    // "My Tasks" (FR-3.4): a collection-group query over every project's
    // tasks, which must filter `assignedTo array-contains <own uid>`.
    // Removing someone from a project unassigns them from its tasks in
    // the same transaction, so this doesn't outlive membership.
    match /{path=**}/tasks/{taskId} {
      allow read: if signedIn() && request.auth.uid in resource.data.assignedTo;
    }

    // Notifications. Without Cloud Functions the sender's app writes them
    // (docs/PLAN.md). The sender must share the notification's project
    // with the recipient and sign as themselves; only known types are
    // accepted (Phase 8 adds more). The recipient reads, marks read and
    // deletes their own; nobody else can.
    match /notifications/{notificationId} {
      function sharesProject(d) {
        let ids = get(/databases/$(database)/documents/projects/$(d.projectId))
          .data.memberIds;
        return request.auth.uid in ids && d.userId in ids;
      }

      function validNotification(d) {
        return d.keys().hasOnly(['userId', 'senderId', 'type', 'projectId',
            'taskId', 'message', 'read', 'createdAt'])
          && d.keys().hasAll(['userId', 'senderId', 'type', 'projectId',
            'message', 'read', 'createdAt'])
          && d.userId is string && d.projectId is string
          && d.senderId == request.auth.uid
          && d.type in ['help_accepted', 'help_requested']
          && d.message is string && d.message.size() > 0
          && d.message.size() <= 200
          && d.read == false
          && d.createdAt == request.time;
      }

      // Per type. "NAME accepted your help request": only in the same
      // batch as the sender's `help_accepted` history entry for the
      // task's current request, at `help_accepted_<requestId>` (so once
      // per request), and only to the member who asked.
      function helpAccepted(d) {
        let requestId = get(/databases/$(database)/documents/projects/$(d.projectId)/tasks/$(d.taskId))
          .data.helpNote.requestId;
        return d.taskId is string
          && notificationId == 'help_accepted_' + requestId
          && getAfter(/databases/$(database)/documents/projects/$(d.projectId)/tasks/$(d.taskId)/history/$('accept_' + requestId))
            .data.who == request.auth.uid
          && get(/databases/$(database)/documents/projects/$(d.projectId)/tasks/$(d.taskId)/history/$(requestId))
            .data.who == d.userId;
      }

      // "NAME requested your help on TASK": only in the same batch that
      // creates the sender's `help_requested` history entry and sets the
      // task's help note to that request, at `help_requested_<requestId>`
      // (so once per request), and only to the helper the note names.
      function helpRequested(d) {
        let requestId = getAfter(/databases/$(database)/documents/projects/$(d.projectId)/tasks/$(d.taskId))
          .data.get('helpNote', {}).get('requestId', '');
        let taggedUserId = getAfter(/databases/$(database)/documents/projects/$(d.projectId)/tasks/$(d.taskId))
          .data.get('helpNote', {}).get('taggedUserId', '');
        let entry = getAfter(/databases/$(database)/documents/projects/$(d.projectId)/tasks/$(d.taskId)/history/$(requestId))
          .data;
        return d.taskId is string
          && requestId is string && requestId != ''
          && notificationId == 'help_requested_' + requestId
          && d.userId != request.auth.uid
          && taggedUserId == d.userId
          && !exists(/databases/$(database)/documents/projects/$(d.projectId)/tasks/$(d.taskId)/history/$(requestId))
          && entry.who == request.auth.uid
          && entry.action == 'help_requested'
          && entry.get('to', '') == d.userId;
      }

      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && validNotification(request.resource.data)
        && sharesProject(request.resource.data)
        && (request.resource.data.type != 'help_accepted'
          || helpAccepted(request.resource.data))
        && (request.resource.data.type != 'help_requested'
          || helpRequested(request.resource.data));

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read'])
        && request.resource.data.read is bool;

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // TODO(phase 4+): comments, history, messages, leaveRequests,
    // notifications.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
